# Copy to .env (gitignored). Every setting has a sane local default.

# --- HRRR: auto | aws | local | synthetic
PPFE_HRRR_SOURCE=auto
# PPFE_HRRR_LOCAL_DIR=D:/hrrr_staged

# --- Model: built-in "placeholder" or "package.module:ClassName"
PPFE_MODEL=placeholder
# PPFE_MODEL=plugins.prithvi_wxc_template:PrithviWxCDownscaler

# --- Inference: local (in-process, GPU auto-detect) | remote (cloud/lab GPU worker)
PPFE_INFERENCE_BACKEND=local
# PPFE_REMOTE_URL=https://gpu-box.example.edu:8100
# PPFE_REMOTE_TOKEN=change-me
PPFE_DEVICE=auto            # auto | cpu | cuda | trt | dml (Windows GPU via onnxruntime-directml)
PPFE_TILE_SIZE=256
PPFE_TILE_BATCH=8

# --- Network-free development
PPFE_OFFLINE=0

# --- Auth
# PPFE_JWT_SECRET=           # generated into data/.jwt_secret if unset
PPFE_ALLOW_SIGNUP=1
PPFE_CORS_ORIGINS=*         # e.g. https://<user>.github.io
