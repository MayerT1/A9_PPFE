# GPU inference worker / portal. Needs NVIDIA Container Toolkit on the host.
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PPFE_DATA_DIR=/data PPFE_DEVICE=cuda
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip libeccodes0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip3 install ".[hrrr]" && pip3 uninstall -y onnxruntime && pip3 install onnxruntime-gpu
COPY frontend ./frontend
COPY aois ./aois
COPY models ./models
COPY plugins ./plugins

EXPOSE 8000
VOLUME ["/data"]
CMD ["python3", "-m", "uvicorn", "ppfe.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
